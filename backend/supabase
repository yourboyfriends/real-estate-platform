-- Increment view count (anti-spam: same IP only counts once per day)
CREATE OR REPLACE FUNCTION increment_property_view(
  p_property_id UUID,
  p_user_id UUID DEFAULT NULL,
  p_ip_address INET DEFAULT NULL
)
RETURNS void AS $$
DECLARE
  already_viewed BOOLEAN;
BEGIN
  -- Check if already viewed today
  SELECT EXISTS(
    SELECT 1 FROM property_views
    WHERE property_id = p_property_id
      AND (user_id = p_user_id OR ip_address = p_ip_address)
      AND viewed_at > NOW() - INTERVAL '24 hours'
  ) INTO already_viewed;
  
  IF NOT already_viewed THEN
    -- Insert view record
    INSERT INTO property_views (property_id, user_id, ip_address)
    VALUES (p_property_id, p_user_id, p_ip_address);
    
    -- Update counter
    UPDATE properties 
    SET view_count = view_count + 1 
    WHERE id = p_property_id;
  END IF;
END;
$$ LANGUAGE plpgsql;

-- Get properties for map (with bounds)
CREATE OR REPLACE FUNCTION get_properties_in_bounds(
  lat1 DECIMAL,
  lng1 DECIMAL,
  lat2 DECIMAL,
  lng2 DECIMAL
)
RETURNS TABLE (
  id UUID,
  title VARCHAR,
  price DECIMAL,
  latitude DECIMAL,
  longitude DECIMAL,
  property_type VARCHAR
) AS $$
BEGIN
  RETURN QUERY
  SELECT 
    p.id,
    p.title,
    p.price,
    p.latitude,
    p.longitude,
    p.property_type
  FROM properties p
  WHERE p.status = 'active'
    AND p.latitude BETWEEN LEAST(lat1, lat2) AND GREATEST(lat1, lat2)
    AND p.longitude BETWEEN LEAST(lng1, lng2) AND GREATEST(lng1, lng2);
END;
$$ LANGUAGE plpgsql;

